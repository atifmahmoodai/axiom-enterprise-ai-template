# Run npm run setup to generate LOCAL credentials in an ignored .env.
APP_URL=http://localhost:3000
AXIOM_MODE=demo
# Disable demo sign-in before exposing an environment to customers.
AXIOM_DEMO_LOGIN=false
DATABASE_URL=postgresql://axiom_app:REPLACE@localhost:5436/axiom
JOB_DATABASE_URL=postgresql://axiom_jobs:REPLACE@localhost:5436/axiom
# Migration/seed environment only. Never pass admin credentials to web/worker.
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE@localhost:5436/axiom
POSTGRES_PASSWORD=GENERATED_BY_SETUP
APP_DB_PASSWORD=GENERATED_BY_SETUP
JOB_DB_PASSWORD=GENERATED_BY_SETUP
KEYCLOAK_ADMIN_PASSWORD=GENERATED_BY_SETUP
AXIOM_STORAGE_DIR=.data
PYTHON_BIN=python3
# Local Keycloak: http://localhost:8081/realms/axiom. Production requires HTTPS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_INTERNAL_ORIGIN=
AXIOM_ALLOW_INSECURE_OIDC=false
# Server only; explicit structured-output-compatible model required.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_PRICE_CARD_VERSION=
AXIOM_GIT_SHA=
# Power BI service identity is separate from application OIDC sign-in.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
# Prefer mounted private-key PEM and SHA-256 thumbprint in production.
POWERBI_CERTIFICATE_PATH=
POWERBI_CERTIFICATE_THUMBPRINT=
