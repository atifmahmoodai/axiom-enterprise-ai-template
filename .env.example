# The Axiom static reference demo requires no environment variables.
# These names are proposals for adapters you implement; the template does not
# read them automatically. Never place real credentials in this example file.

# Optional public configuration. NEXT_PUBLIC_* values are exposed to browsers.
# NEXT_PUBLIC_APP_URL=https://app.example.com
# NEXT_PUBLIC_API_ORIGIN=https://api.example.com

# Server-only values for a full runtime or separate backend. Static export
# cannot use these to provide authenticated API routes or secret storage.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# AUTH_ISSUER=https://identity.example.com
# AUTH_AUDIENCE=axiom-api
# SESSION_SECRET=replace-with-a-cryptographically-random-value
# TELEMETRY_API_URL=https://telemetry.example.com
# TELEMETRY_API_TOKEN=replace-in-the-host-secret-manager
# LEAD_WEBHOOK_URL=https://crm.example.com/lead-intake
# LEAD_WEBHOOK_SECRET=replace-in-the-host-secret-manager
# BILLING_WEBHOOK_SECRET=replace-in-the-host-secret-manager
